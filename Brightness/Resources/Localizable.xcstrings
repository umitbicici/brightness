{
  "sourceLanguage": "en",
  "strings": {
    "%@ brightness": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parlaklığı"
          }
        }
      }
    },
    "%@ starts automatically in the menu bar when you log in.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, oturum açtığınızda menü çubuğunda otomatik olarak başlar."
          }
        }
      }
    },
    "About %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Hakkında"
          }
        }
      }
    },
    "Automatically check for updates": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri otomatik olarak denetle"
          }
        }
      }
    },
    "Built-in Display": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dahili Ekran"
          }
        }
      }
    },
    "Check Now…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi Denetle…"
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri Denetle…"
          }
        }
      }
    },
    "Couldn't change the brightness (error %d).": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlaklık değiştirilemedi (hata %d)."
          }
        }
      }
    },
    "Detected Displays": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Algılanan Ekranlar"
          }
        }
      }
    },
    "Display %u": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran %u"
          }
        }
      }
    },
    "Displays": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranlar"
          }
        }
      }
    },
    "External monitors are controlled over DDC/CI, which must be turned on in the monitor's menu.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harici monitörler DDC/CI ile kontrol edilir; monitörün menüsünde DDC/CI açık olmalıdır."
          }
        }
      }
    },
    "General": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel"
          }
        }
      }
    },
    "Launch at login": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girişte başlat"
          }
        }
      }
    },
    "More": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer"
          }
        }
      }
    },
    "No Displays Found": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Bulunamadı"
          }
        }
      }
    },
    "Not responding": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıt vermiyor"
          }
        }
      }
    },
    "Not supported": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenmiyor"
          }
        }
      }
    },
    "Quit": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çık"
          }
        }
      }
    },
    "Rescan": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden Tara"
          }
        }
      }
    },
    "Rescan displays": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranları yeniden tara"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar…"
          }
        }
      }
    },
    "Show on-screen indicator": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran üstü göstergeyi göster"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem"
          }
        }
      }
    },
    "The monitor doesn't respond to DDC/CI commands. Turn on DDC/CI in the monitor's menu; if you use a dock or an adapter, try connecting the monitor directly.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitör DDC/CI komutlarına yanıt vermiyor. Monitörün menüsünden DDC/CI ayarını açın; dock veya adaptör kullanıyorsanız monitörü doğrudan bağlamayı deneyin."
          }
        }
      }
    },
    "This display doesn't support brightness control.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekran parlaklık kontrolünü desteklemiyor."
          }
        }
      }
    },
    "Updates": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeler"
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm %@"
          }
        }
      }
    },
    "When the brightness changes, an indicator appears in the top-right corner of the adjusted display.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlaklık değiştiğinde, ayarlanan ekranın sağ üst köşesinde bir gösterge belirir."
          }
        }
      }
    }
  },
  "version": "1.0"
}
